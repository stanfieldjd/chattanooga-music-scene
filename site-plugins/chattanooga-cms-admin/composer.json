{
  "name": "stanfieldjd/chattanooga-cms-admin",
  "description": "Chattanooga CMS Admin with the official WordPress MCP Adapter transport.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0",
    "wordpress/mcp-adapter": "0.6.1",
    "wordpress/php-mcp-schema": "0.1.3",
    "automattic/jetpack-autoloader": "5.0.23"
  },
  "config": {
    "allow-plugins": {
      "automattic/jetpack-autoloader": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
