{
  "name": "chattanooga/robust-mcp-workbench",
  "description": "Robust MCP 2026-07-28 workbench for Chattanooga Music Scene.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-openssl": "*",
    "firebase/php-jwt": "^7.1.1",
    "mcp/sdk": "~0.8.1",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "opis/json-schema": "^2.6",
    "psr/simple-cache": "^3.0",
    "symfony/cache": "^7.3",
    "symfony/http-client": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "Chattanooga\\RobustMcp\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false,
      "phpdocumentor/shim": true
    },
    "platform": {
      "php": "8.2.0"
    },
    "sort-packages": true
  }
}
